# FinAlly — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Required: OpenRouter API key for AI chat functionality
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (for testing)
# Leave as "false" for normal operation
LLM_MOCK=false

# Optional: Custom SQLite database path (default: /app/db/finally.db in container)
# DB_PATH=db/finally.db
